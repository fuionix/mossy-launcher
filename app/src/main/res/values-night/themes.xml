<resources>
    <!-- Base night application theme. -->
    <style name="Theme.MossyLauncher" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@android:color/background_light</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@android:color/background_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@android:color/background_dark</item>
        <!-- Background -->
        <item name="android:background">@android:color/background_dark</item>
        <item name="colorOnBackground">@android:color/background_light</item>
        <!-- Text -->
        <item name="fontFamily">@font/google_sans_regular</item>
        <item name="android:textColor">@android:color/background_light</item>
        <!-- Button style -->
        <item name="materialButtonStyle">@style/Launcher.Button</item>
    </style>
</resources>